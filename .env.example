# ==============================================================================
# DATABASE CONNECTION
# ------------------------------------------------------------------------------
# 1. Lokal (SQLite): Biarkan file:./dev.db
# 2. Produksi / Vercel (PostgreSQL - Neon / Supabase / Prisma Postgres):
#    Ganti dengan Connection String PostgreSQL Anda, misal:
#    DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"
# ==============================================================================
DATABASE_URL="file:./dev.db"

# Kunci HMAC penandatangan sesi login pengguna (isi teks acak panjang di Vercel)
SESSION_SECRET="warungin-naisc-2026-secret-key"

# Wajib diisi agar wawancara kebutuhan toko & perakitan dashboard berjalan dengan Gemini AI
GEMINI_API_KEY=""
